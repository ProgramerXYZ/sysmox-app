{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sysmox",
  "version": "0.1.0",
  "identifier": "com.programerxyz.sysmox",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "sysmox",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "external_binarys":[
      "bin/sysmox",
      "bin/duration_format",
      "bin/format_freq",
      "bin/format_freq_percore",
      "bin/format_size",
      "bin/format_time",
      "bin/format_to_ghz"

    ]
  }
}
